<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>org.iodx</groupId>
    <artifactId>iodx-csharp-codegen</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <properties>
        <congocc.version>2.1.0</congocc.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <build>
        <defaultGoal>generate-sources</defaultGoal>
        <plugins>
            <plugin>
                <groupId>org.congocc</groupId>
                <artifactId>org.congocc.maven.plugin</artifactId>
                <version>${congocc.version}</version>
                <executions>
                    <execution>
                        <id>generate-csharp-parser</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>ccc-generate</goal>
                        </goals>
                        <configuration>
                            <lang>csharp</lang>
                            <sourceDirectory>${project.basedir}/../grammar</sourceDirectory>
                            <outputDirectory>${project.basedir}/../src/Iodx/Generated/CongoCC</outputDirectory>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
